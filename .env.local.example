DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-dev-only-change-me
DJANGO_DEBUG=true
FIXED_TEST_ACCOUNT_ENABLED=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

POSTGRES_DB=corpus_platform
POSTGRES_USER=corpus_platform
POSTGRES_PASSWORD=corpus_platform
DATABASE_URL=postgres://corpus_platform:corpus_platform@db:5432/corpus_platform

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600

DATA_ROOT=/app/data
USER_UPLOAD_MAX_FILE_BYTES=31457280
USER_UPLOAD_TOTAL_BYTES=31457280
TEST_UPLOAD_MAX_FILE_BYTES=2097152
TEST_UPLOAD_TOTAL_BYTES=5242880
UPLOAD_SCANNER_BACKEND=apps.corpora.scanners.DisabledUploadScanner

EXPORT_TTL_SECONDS=86400
EXPORT_MAX_ROWS=100000
EXPORT_MAX_DOWNLOADS=5
EXPORT_MAX_JOBS_PER_HOUR=10

AGENT_RUN_LEASE_SECONDS=300
AGENT_APPROVAL_TTL_SECONDS=600
AGENT_APPROVAL_CLEANUP_BATCH_SIZE=100
AGENT_EXTERNAL_WAIT_TTL_SECONDS=3600
AGENT_EXTERNAL_WAIT_CLEANUP_BATCH_SIZE=100
AGENT_MAX_RUNS_PER_HOUR=30
# Leave disabled for deterministic local development. When enabled, the Agent
# only sends bounded evidence to an OpenAI-compatible summarization endpoint.
AGENT_MODEL_ENABLED=false
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_TIMEOUT_SECONDS=20
AGENT_MODEL_MAX_OUTPUT_TOKENS=600
AGENT_MODEL_INPUT_USD_PER_1M=0
AGENT_MODEL_OUTPUT_USD_PER_1M=0

# Hybrid RAG uses a separate OpenAI-compatible embedding endpoint. Enable only
# after supplying an embedding model and a non-committed API key.
RAG_INDEXING_ENABLED=false
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_MAX_DIMENSION=4096
# Milvus Standalone is included in local Compose. Production may point to a
# separately managed Milvus endpoint; never commit a production token.
RAG_MILVUS_URI=http://milvus:19530
RAG_MILVUS_TOKEN=
RAG_MILVUS_DATABASE=default
RAG_MILVUS_TIMEOUT_SECONDS=10
RAG_MILVUS_COLLECTION_PREFIX=rag_
RAG_MILVUS_HNSW_M=16
RAG_MILVUS_HNSW_EF_CONSTRUCTION=200
RAG_MILVUS_HNSW_EF_SEARCH=64
RAG_MILVUS_CANDIDATE_MULTIPLIER=10
RAG_CHUNK_MAX_CHARACTERS=1800
RAG_MAX_CHUNKS=200000
RAG_INDEX_LEASE_SECONDS=900

# Go data-plane auditor. The transactional outbox publishes commands into a
# Redis Stream, Go workers publish terminal result events, and Django's result
# projector commits state before acknowledging the result message.
CORPUS_AUDITOR_QUEUE_ENABLED=true
CORPUS_AUDITOR_QUEUE_URL=redis://redis:6379/0
CORPUS_AUDITOR_COMPAT_API_TOKEN=local-auditor-compat-token
CORPUS_AUDITOR_COMMAND_STREAM=corpus:audit:commands:v1
CORPUS_AUDITOR_COMMAND_GROUP=corpus-auditor-v1
CORPUS_AUDITOR_RESULT_STREAM=corpus:audit:results:v1
CORPUS_AUDITOR_RESULT_GROUP=django-audit-projector-v1
CORPUS_AUDITOR_STREAM_MAXLEN=100000
AUDIT_RESULT_PROJECT_INTERVAL_SECONDS=1
AUDITOR_WORKERS=2
AUDITOR_QUEUE_CAPACITY=100
AUDITOR_AUDIT_TIMEOUT=10m

OUTBOX_PUBLISH_INTERVAL_SECONDS=5
OUTBOX_LEASE_SECONDS=30
OUTBOX_RETRY_INITIAL_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_PUBLISHED_RETENTION_DAYS=7
OUTBOX_CLEANUP_INTERVAL_SECONDS=3600
METRICS_BEARER_TOKEN=local-metrics-token
