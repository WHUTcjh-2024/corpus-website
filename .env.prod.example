DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

DATABASE_URL=postgres://user:password@postgres-host:5432/corpus_platform
REDIS_URL=redis://redis-host:6379/0
CELERY_BROKER_URL=redis://redis-host:6379/0
CELERY_RESULT_BACKEND=redis://redis-host:6379/1
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600

DATA_ROOT=/app/data
USER_UPLOAD_MAX_FILE_BYTES=31457280
USER_UPLOAD_TOTAL_BYTES=31457280
TEST_UPLOAD_MAX_FILE_BYTES=2097152
TEST_UPLOAD_TOTAL_BYTES=5242880
UPLOAD_SCANNER_BACKEND=apps.corpora.scanners.ClamAVUploadScanner
CLAMAV_HOST=clamav-host
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15

EXPORT_TTL_SECONDS=86400
EXPORT_MAX_ROWS=100000
EXPORT_MAX_DOWNLOADS=5
EXPORT_MAX_JOBS_PER_HOUR=10

AGENT_RUN_LEASE_SECONDS=300
AGENT_APPROVAL_TTL_SECONDS=600
AGENT_APPROVAL_CLEANUP_BATCH_SIZE=100
AGENT_MAX_RUNS_PER_HOUR=30
# Set to true only with all three model settings present. Do not commit a key.
AGENT_MODEL_ENABLED=false
AGENT_MODEL_BASE_URL=https://model-gateway.example/v1
AGENT_MODEL_API_KEY=replace-with-model-api-key
AGENT_MODEL_NAME=replace-with-model-name
AGENT_MODEL_TIMEOUT_SECONDS=20
AGENT_MODEL_MAX_OUTPUT_TOKENS=600
AGENT_MODEL_INPUT_USD_PER_1M=0
AGENT_MODEL_OUTPUT_USD_PER_1M=0

CORPUS_AUDITOR_SERVICE_ENABLED=true
CORPUS_AUDITOR_SERVICE_TOKEN=replace-with-a-separate-long-random-service-token
CORPUS_AUDITOR_CALLBACK_TOKEN=replace-with-a-separate-long-random-callback-token
CORPUS_AUDITOR_SERVICE_TIMEOUT_SECONDS=10
CORPUS_AUDITOR_CALLBACK_MAX_SKEW_SECONDS=300
CORPUS_AUDITOR_RECONCILE_BATCH_SIZE=100
AUDITOR_WORKERS=2
AUDITOR_QUEUE_CAPACITY=100
AUDITOR_AUDIT_TIMEOUT=10m
# Absolute host directory mounted read/write into web, workers and Go auditor.
DATA_ROOT_HOST_PATH=/srv/corpus-platform/data

OUTBOX_PUBLISH_INTERVAL_SECONDS=5
OUTBOX_LEASE_SECONDS=30
OUTBOX_RETRY_INITIAL_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_PUBLISHED_RETENTION_DAYS=7
OUTBOX_CLEANUP_INTERVAL_SECONDS=3600
METRICS_BEARER_TOKEN=replace-with-a-separate-long-random-secret
METRICS_BEARER_TOKEN_FILE=./deploy/secrets/metrics_bearer_token
